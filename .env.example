# ── Backend (server) ─────────────────────────────────────────
PORT=5000

# Sarvam AI key — powers speech-to-text (transcription), transcript translation,
# and clinical report generation. Get one from https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Sarvam speech-to-text endpoint. The API host (origin) is derived from this and
# reused for the translation/report chat endpoints. Leave as the default below.
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# MongoDB Atlas connection string. The database name is taken from the URI path
# (e.g. .../carescribe?... uses the "carescribe" database).
# MONGO_URI is also accepted as a legacy fallback.
MONGODB_URI=mongodb+srv://<user>:<password>@<host>.mongodb.net/carescribe?retryWrites=true&w=majority

# Optional: lock CORS to your frontend origin(s) in production (comma-separated).
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=

# ── Frontend (Vite) ──────────────────────────────────────────
# Base URL of the backend API. Leave EMPTY for local dev (uses the Vite proxy).
# In production set it to your Render backend URL, e.g.
# https://carescribe-api.onrender.com
VITE_API_BASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for the doctor session cookie (JWT). REQUIRED.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the browser app is served from. Required in production so the session
# cookie can be sent cross-site from Vercel to Render (comma-separated).
# CORS_ORIGIN=https://your-app.vercel.app
