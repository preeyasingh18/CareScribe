# ── Backend (server) ─────────────────────────────────────────
PORT=5000

# Sarvam AI key — powers speech-to-text (transcription), transcript translation,
# and clinical report generation. Get one from https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Sarvam speech-to-text endpoint. The API host (origin) is derived from this and
# reused for the translation/report chat endpoints. Leave as the default below.
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# MongoDB Atlas connection string. The database name is taken from the URI path
# (e.g. .../carescribe?... uses the "carescribe" database).
# MONGO_URI is also accepted as a legacy fallback.
MONGODB_URI=mongodb+srv://<user>:<password>@<host>.mongodb.net/carescribe?retryWrites=true&w=majority

# Optional: Sarvam chat model used for report generation and translation.
# Defaults to sarvam-105b-conversations. The alternative, sarvam-105b, is a
# reasoning model: on extraction prompts it spends its entire token budget on an
# internal reasoning trace and returns nothing, which is what made report
# generation take minutes.
SARVAM_CHAT_MODEL=

# Optional: how long a single Sarvam chat call may take before it is aborted
# (milliseconds). Report generation runs its section groups concurrently, so this
# is the per-call ceiling, not the total. Defaults to 60000.
SARVAM_TIMEOUT_MS=

# Optional: lock CORS to your frontend origin(s) in production (comma-separated).
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=

# ── Frontend (Vite) ──────────────────────────────────────────
# Base URL of the backend API. Leave EMPTY for local dev (uses the Vite proxy).
# In production set it to your Render backend URL, e.g.
# https://carescribe-api.onrender.com
VITE_API_BASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for the doctor session cookie (JWT). REQUIRED.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the browser app is served from. Required in production so the session
# cookie can be sent cross-site from Vercel to Render (comma-separated).
# CORS_ORIGIN=https://your-app.vercel.app

# ── Password reset email (Gmail SMTP via nodemailer) ────────────────────────
# Forgot Password emails a single-use reset link. Nothing is simulated: if these
# are missing or Gmail rejects them, the server refuses the request, logs the
# reason at startup, and tells the user — it never claims an email was sent.
#
# EMAIL_PASS must be a Gmail APP PASSWORD (16 characters), not the account
# password. Generate one at https://myaccount.google.com/apppasswords with
# 2-Step Verification enabled on the EMAIL_USER account.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CareScribe <your-address@gmail.com>

# Where the browser app is served from, used to build the link in the email.
# Falls back to CORS_ORIGIN, then to the requesting origin (fine for local dev).
APP_URL=
